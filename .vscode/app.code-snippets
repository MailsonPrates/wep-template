{
	"Wep: config do módulo (module.php)": {
		"scope": "php",
		"prefix": [
			"wep module config"
		],
		"description": "config/module.php de um módulo (rotas, CRUD automático, hooks). Depois rode: php app update",
		"body": [
			"<?php",
			"",
			"/**",
			" * ATENÇÃO: depois de alterar este arquivo rode  >>> php app update",
			" */",
			"",
			"return [",
			"\t'title' => '${1:Título do módulo}',",
			"\t'db' => [",
			"\t\t'table' => '${2:tabela}',",
			"\t],",
			"\t// CRUD automático: o front só envia id, campos e filtros declarados (Wep\\Api\\ClientPayload)",
			"\t'api' => [",
			"\t\t'primary_key' => '${3:id}',",
			"\t\t'fillable' => [${4:'name'}],",
			"\t\t'filters' => [${5:'status'}],",
			"\t\t'order_by' => ['${3:id}', 'DESC'],",
			"\t],",
			"\t'routes' => [",
			"\t\t'path' => '/${6:modulo}',",
			"\t\t'methods' => ['get', 'create', 'update', 'delete'],",
			"\t\t'use_middlewares' => ['isLogged', 'checkPermission'],",
			"\t\t'groups' => [",
			"\t\t\t['path' => '/', 'view' => 'index'],",
			"\t\t\t['path' => '/{id}/edit', 'view' => 'Edit', 'label' => 'Editar'],",
			"\t\t\t['path' => '/${7:acao}', 'method' => '${8:acao}', 'label' => '${9:descrição da ação}'],",
			"\t\t],",
			"\t],",
			"\t'hooks' => [",
			"\t\t'after_build' => [],",
			"\t],",
			"];"
		]
	},
	"Wep: Model do módulo": {
		"scope": "php",
		"prefix": [
			"wep model"
		],
		"description": "Model (tabela de 'db' no module.php): get/create/update/delete, find, fromClient...",
		"body": [
			"<?php",
			"",
			"namespace App\\\\${TM_DIRECTORY/^.*?[\\/\\\\]src[\\/\\\\]|([\\/\\\\])/${1:+\\\\}/g};",
			"",
			"use Wep\\Model;",
			"",
			"class ${TM_FILENAME_BASE}",
			"{",
			"\tuse Model;",
			"}"
		]
	},
	"Wep: Api do módulo": {
		"scope": "php",
		"prefix": [
			"wep api"
		],
		"description": "Controller das rotas com 'method' do module.php",
		"body": [
			"<?php",
			"",
			"namespace App\\\\${TM_DIRECTORY/^.*?[\\/\\\\]src[\\/\\\\]|([\\/\\\\])/${1:+\\\\}/g};",
			"",
			"use Wep\\Controller;",
			"use Wep\\Response;",
			"use Wep\\Api\\InvalidPayloadException;",
			"",
			"class ${TM_FILENAME_BASE}",
			"{",
			"\tuse Controller;",
			"",
			"\t/**",
			"\t * Sobrescreve o update do CRUD automático (ex.: validar antes de gravar).",
			"\t */",
			"\tpublic function update(\\$request, \\$response)",
			"\t{",
			"\t\ttry {",
			"\t\t\t\\$payload = ${1:Model}::clientPayload('update');",
			"\t\t} catch (InvalidPayloadException \\$e) {",
			"\t\t\treturn \\$response->json(Response::error(\\$e->getMessage()));",
			"\t\t}",
			"",
			"\t\t${2:// validações}",
			"",
			"\t\treturn \\$response->json(${1:Model}::updateById(\\$payload['id'], \\$payload['fields']));",
			"\t}",
			"}"
		]
	},
	"Wep: método da Api": {
		"scope": "php",
		"prefix": [
			"wep api method"
		],
		"description": "Método de rota (custom) da Api do módulo",
		"body": [
			"public function ${1:acao}(\\$request, \\$response)",
			"{",
			"\t\\$${2:valor} = \\$request->${2:valor} ?? null;",
			"",
			"\t${0}",
			"",
			"\treturn \\$response->json(Response::success([]));",
			"}"
		]
	},
	"Wep: middleware": {
		"scope": "php",
		"prefix": [
			"wep middleware",
			"app middleware",
			"app module middleware"
		],
		"description": "Middleware (src/Common/Middlewares ou <Módulo>/Middlewares). Registre em config/app.php ou no module.php",
		"body": [
			"<?php",
			"",
			"namespace App\\\\${TM_DIRECTORY/^.*?[\\/\\\\]src[\\/\\\\]|([\\/\\\\])/${1:+\\\\}/g};",
			"",
			"use Wep\\Http\\Middleware;",
			"",
			"class ${TM_FILENAME_BASE} implements Middleware",
			"{",
			"\t/**",
			"\t * Chame \\$next() para seguir. Para barrar: responda e encerre, ou lance Wep\\Http\\HttpException.",
			"\t */",
			"\tpublic function handle(\\$request, \\$next)",
			"\t{",
			"\t\t${0}",
			"",
			"\t\t\\$next();",
			"\t\treturn true;",
			"\t}",
			"}"
		]
	},
	"Wep: hook do build": {
		"scope": "php",
		"prefix": [
			"wep hook"
		],
		"description": "Hook do php app update (before_build, each_route, after_build no module.php)",
		"body": [
			"<?php",
			"",
			"namespace App\\\\${TM_DIRECTORY/^.*?[\\/\\\\]src[\\/\\\\]|([\\/\\\\])/${1:+\\\\}/g};",
			"",
			"class ${TM_FILENAME_BASE}",
			"{",
			"\t/**",
			"\t * Exceção vira ALERTA no php app update (ou aborta com --strict).",
			"\t */",
			"\tpublic function handle(${1:\\$route = null})",
			"\t{",
			"\t\t${0}",
			"\t}",
			"}"
		]
	},
	"Wep: template de página (PHP)": {
		"scope": "php",
		"prefix": [
			"wep template",
			"app template",
			"app module template"
		],
		"description": "Template PHP da página (como o src/Common/Templates/Main.php)",
		"body": [
			"<?php",
			"",
			"namespace App\\\\${TM_DIRECTORY/^.*?[\\/\\\\]src[\\/\\\\]|([\\/\\\\])/${1:+\\\\}/g};",
			"",
			"use App\\App;",
			"use App\\Modules\\User\\User;",
			"use Wep\\View\\Template\\Html;",
			"use Wep\\View\\Template\\iTemplate;",
			"",
			"class ${TM_FILENAME_BASE} implements iTemplate",
			"{",
			"\tpublic function build(\\$route, \\$request, \\$template): string",
			"\t{",
			"\t\t\\$assets = is_file(DIR_STORAGE . '/builds/view-assets.build.php') ? include DIR_STORAGE . '/builds/view-assets.build.php' : [];",
			"",
			"\t\t\\$html = \\$template->html([",
			"\t\t\t'title' => \\$route->document_title ?? App::config('name|title', ''),",
			"\t\t\t'head' => [",
			"\t\t\t\t['link', ['rel' => 'icon', 'href' => App::assets('images/favicon.png')]],",
			"\t\t\t\t['link', ['rel' => 'stylesheet', 'href' => App::assets('css/main.css', true)]],",
			"\t\t\t\t// Html::json: os dados não conseguem fechar o <script>",
			"\t\t\t\t['script', ['html' => 'window.App = ' . Html::json(['user' => User::getData()])]],",
			"\t\t\t\t...(is_array(\\$assets) ? \\$assets : []),",
			"\t\t\t]",
			"\t\t]);",
			"",
			"\t\t\\$html->append('body', [",
			"\t\t\t\\$html->main(['id' => 'app'])",
			"\t\t]);",
			"",
			"\t\treturn \\$html->build();",
			"\t}",
			"}"
		]
	},
	"Wep: página de lista (React)": {
		"scope": "javascript,javascriptreact",
		"prefix": [
			"wep page list"
		],
		"description": "Tela com TemplateMain, lista da API e remover",
		"body": [
			"import { Link } from \"react-router\";",
			"import { Button } from \"react-bootstrap\";",
			"import { HiOutlineTrash, HiMiniPlus } from \"react-icons/hi2\";",
			"import { ${1:Modulo}Api } from \"api\";",
			"import { ListState, TemplateMain } from \"components\";",
			"import { useAction, useApi } from \"hooks\";",
			"",
			"export default function ${6:Lista}() {",
			"\tconst list = useApi(() => ${1:Modulo}Api.get(), [], { initial: [] });",
			"\tconst [remove, removing] = useAction((id) => ${1:Modulo}Api.delete(id), { confirm: \"Remover?\", success: \"Removido\" });",
			"",
			"\tconst onRemove = async (id) => {",
			"\t\tconst res = await remove(id);",
			"\t\tif (res && !res.error) list.setData((items) => items.filter((item) => item.${2:id} !== id));",
			"\t};",
			"",
			"\treturn (",
			"\t\t<TemplateMain",
			"\t\t\ttitle=\"${3:Título}\"",
			"\t\t\tactions={<Link className=\"btn btn-primary\" to=\"${4:/modulo}/create/\"><HiMiniPlus /> Novo</Link>}",
			"\t\t>",
			"\t\t\t<ListState loading={list.loading || removing.loading} items={list.data}>",
			"\t\t\t\t{(item) => (",
			"\t\t\t\t\t<div key={item.${2:id}} className=\"my-2 p-2 border rounded bg-white d-flex align-items-center justify-content-between\">",
			"\t\t\t\t\t\t<Link className=\"text-reset\" to={`${4:/modulo}/\\${item.${2:id}}/edit/`}>{item.${5:name}}</Link>",
			"\t\t\t\t\t\t<Button variant=\"link\" className=\"text-danger\" onClick={() => onRemove(item.${2:id})}><HiOutlineTrash /></Button>",
			"\t\t\t\t\t</div>",
			"\t\t\t\t)}",
			"\t\t\t</ListState>",
			"\t\t</TemplateMain>",
			"\t);",
			"}"
		]
	},
	"Wep: página de formulário (React)": {
		"scope": "javascript,javascriptreact",
		"prefix": [
			"wep page form"
		],
		"description": "Formulário com useForm, useAction, Field e FormActions (criar e editar)",
		"body": [
			"import { useEffect } from \"react\";",
			"import { useNavigate, useParams } from \"react-router\";",
			"import { Form } from \"react-bootstrap\";",
			"import { ${1:Modulo}Api } from \"api\";",
			"import { Field, FormActions, TemplateMain } from \"components\";",
			"import { useAction, useApi, useForm } from \"hooks\";",
			"",
			"export default function ${TM_FILENAME_BASE}() {",
			"\tconst { id } = useParams();",
			"\tconst navigate = useNavigate();",
			"\tconst item = useApi(() => ${1:Modulo}Api.get(id), [id], { enabled: Boolean(id) });",
			"",
			"\tconst form = useForm({ ${2:name}: \"\" }, {",
			"\t\t${2:name}: { required: \"${3:Preencha o nome}\" },",
			"\t});",
			"",
			"\tuseEffect(() => {",
			"\t\tif (item.data) form.reset({ ${2:name}: item.data.${2:name} || \"\" });",
			"\t}, [item.data]); // eslint-disable-line react-hooks/exhaustive-deps",
			"",
			"\tconst [save, { loading }] = useAction(",
			"\t\t(fields) => (id ? ${1:Modulo}Api.update(id, fields) : ${1:Modulo}Api.create(fields)),",
			"\t\t{ success: \"Salvo com sucesso\" }",
			"\t);",
			"",
			"\tconst onSubmit = async (e) => {",
			"\t\te.preventDefault();",
			"\t\tif (!form.validate()) return;",
			"",
			"\t\tconst res = await save(form.values);",
			"\t\tif (res && !res.error) navigate(\"${4:/modulo}/\");",
			"\t};",
			"",
			"\treturn (",
			"\t\t<TemplateMain title={id ? \"Editar\" : \"Novo\"}>",
			"\t\t\t<Form noValidate onSubmit={onSubmit} className={item.loading || loading ? \"full-loading\" : \"\"}>",
			"\t\t\t\t<FormActions back=\"${4:/modulo}/\" saving={loading} />",
			"\t\t\t\t<Field label=\"${5:Nome}\" {...form.field(\"${2:name}\")} />",
			"\t\t\t</Form>",
			"\t\t</TemplateMain>",
			"\t);",
			"}"
		]
	},
