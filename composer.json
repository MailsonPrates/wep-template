{
    "name": "wep/project",
    "type": "project",
    "version": "2.0.2",
    "description": "A project template to make creating new Wep projects easier.",
    "keywords": ["wep"],
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "require": {
        "php": "^8.2",
        "wep/framework": "^2.0"
    },
    "scripts": {
        "post-create-project-cmd": [
            "php -r \"file_exists('config/.env') || copy('config/.env.example', 'config/.env');\""
        ]
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}