# Assets são só arquivos estáticos: nada aqui é executado como script.
# Defesa extra para a pasta de uploads (assets/images): mesmo que um .php chegue aqui, ele não roda.
<FilesMatch "(?i)\.(php\d?|phtml|phar|phps|pht|cgi|pl|py|sh)$">
    Require all denied
</FilesMatch>

Options -ExecCGI -Indexes

<IfModule mod_php.c>
    php_flag engine off
</IfModule>
